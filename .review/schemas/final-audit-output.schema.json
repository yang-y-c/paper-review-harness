{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "reviewed_claims", "result", "checks", "issues", "review_notes"],
  "properties": {
    "agent": {"const": "final_integrity_auditor"},
    "reviewed_claims": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{2,}$"}, "uniqueItems": true},
    "result": {"enum": ["PASS", "FAIL", "NEEDS_AUTHOR"]},
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "status", "evidence", "detail"],
        "properties": {
          "dimension": {"enum": ["TITLE", "ABSTRACT", "SECTION_NAMES", "CONCLUSION", "LOGIC_CHAIN", "TERMINOLOGY", "NOTATION", "HIERARCHY", "LANGUAGE", "CLAIM_SCOPE"]},
          "status": {"enum": ["PASS", "FAIL", "NEEDS_AUTHOR"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "issues": {"type": "array", "items": {"$ref": "review-output.schema.json#/$defs/issue"}},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
