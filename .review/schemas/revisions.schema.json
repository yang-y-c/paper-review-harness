{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/paper-review/revisions.schema.json",
  "title": "Revision Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revisions"],
  "properties": {
    "schema_version": {"const": 1},
    "revisions": {"type": "array", "items": {"$ref": "#/$defs/revision"}}
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "issue_id", "revision_status", "changed_files", "changed_locations",
        "affected_claims", "change_types", "resolution_summary", "created_at", "run_id"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]{3,}$"},
        "issue_id": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]{3,}$"},
        "revision_status": {"enum": ["CLAIMED_FIXED", "NEEDS_AUTHOR"]},
        "changed_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "changed_locations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "affected_claims": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{2,}$"}, "uniqueItems": true},
        "change_types": {"type": "array", "minItems": 1, "items": {"enum": ["proof", "scope", "assumption", "definition", "algorithm", "numerical", "evidence", "structure", "prose", "citation", "production"]}, "uniqueItems": true},
        "resolution_summary": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "run_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
