{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "reviewed_claims", "issues", "review_notes"],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_id", "location", "severity", "category", "problem", "why_it_matters", "required_action", "verification_criterion", "status", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]{3,}$"},
        "claim_id": {"type": ["string", "null"], "pattern": "^C[0-9]{2,}$"},
        "location": {"type": "string", "minLength": 1},
        "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR", "STYLE"]},
        "category": {"enum": ["theory", "algorithm", "numerical", "argument", "evidence", "consistency", "presentation", "production"]},
        "problem": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1},
        "verification_criterion": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "NEEDS_AUTHOR"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "agent": {
      "enum": [
        "theory_reviewer", "algorithm_reviewer", "numerical_reviewer",
        "argument_reviewer", "challenger", "macro_architect",
        "hierarchy_reviewer", "language_coherence_reviewer", "final_integrity_auditor"
      ]
    },
    "reviewed_claims": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{2,}$"}, "uniqueItems": true},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
