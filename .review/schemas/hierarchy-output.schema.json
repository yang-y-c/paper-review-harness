{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "reviewed_claims", "granularity", "nodes", "issues", "review_notes"],
  "properties": {
    "agent": {"const": "hierarchy_reviewer"},
    "reviewed_claims": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{2,}$"}, "uniqueItems": true},
    "granularity": {"enum": ["MACRO_ONLY", "SECTION", "SUBSECTION", "PARAGRAPH", "SENTENCE", "ADAPTIVE"]},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent_id", "level", "heading", "location", "purpose", "input_from_previous", "output_to_next", "theme_anchors", "claim_ids", "transition_in", "transition_out", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^N[0-9]{3,}$"},
          "parent_id": {"type": ["string", "null"], "pattern": "^N[0-9]{3,}$"},
          "level": {"enum": ["SECTION", "SUBSECTION"]},
          "heading": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "input_from_previous": {"type": "string"},
          "output_to_next": {"type": "string"},
          "theme_anchors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{2,}$"}, "uniqueItems": true},
          "transition_in": {"type": "string"},
          "transition_out": {"type": "string"},
          "status": {"enum": ["PASS", "REVISE", "NEEDS_AUTHOR"]}
        }
      }
    },
    "issues": {"type": "array", "items": {"$ref": "review-output.schema.json#/$defs/issue"}},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
