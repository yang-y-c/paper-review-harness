{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "reviewed_claims", "contract", "issues", "review_notes"],
  "properties": {
    "agent": {"const": "macro_architect"},
    "reviewed_claims": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{2,}$"}, "uniqueItems": true},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "title", "abstract", "section_naming", "conclusion", "logic_chain", "terminology", "notation", "drift_controls"],
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic", "research_question", "scope", "core_contribution", "exclusions", "anchors"],
          "properties": {
            "topic": {"type": "string", "minLength": 1},
            "research_question": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "core_contribution": {"type": "string", "minLength": 1},
            "exclusions": {"type": "array", "items": {"type": "string"}},
            "anchors": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current", "recommended", "topic_alignment", "specificity", "style_pattern", "status"],
          "properties": {
            "current": {"type": "string"},
            "recommended": {"type": "string", "minLength": 1},
            "topic_alignment": {"type": "string", "minLength": 1},
            "specificity": {"type": "string", "minLength": 1},
            "style_pattern": {"type": "string", "minLength": 1},
            "status": {"enum": ["PASS", "REVISE", "NEEDS_AUTHOR"]}
          }
        },
        "abstract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["problem", "gap", "objective", "method", "evidence", "results", "contribution", "scope_limits", "status"],
          "properties": {
            "problem": {"type": "string"},
            "gap": {"type": "string"},
            "objective": {"type": "string"},
            "method": {"type": "string"},
            "evidence": {"type": "string"},
            "results": {"type": "string"},
            "contribution": {"type": "string"},
            "scope_limits": {"type": "string"},
            "status": {"enum": ["PASS", "REVISE", "NEEDS_AUTHOR"]}
          }
        },
        "section_naming": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "headings"],
          "properties": {
            "policy": {"type": "string", "minLength": 1},
            "headings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["location", "current", "recommended", "purpose", "status"],
                "properties": {
                  "location": {"type": "string"},
                  "current": {"type": "string"},
                  "recommended": {"type": "string"},
                  "purpose": {"type": "string"},
                  "status": {"enum": ["PASS", "REVISE", "NEEDS_AUTHOR"]}
                }
              }
            }
          }
        },
        "conclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answers_research_question", "supported_findings", "scope_consistency", "limitations", "new_claims", "status"],
          "properties": {
            "answers_research_question": {"type": "string"},
            "supported_findings": {"type": "array", "items": {"type": "string"}},
            "scope_consistency": {"type": "string"},
            "limitations": {"type": "string"},
            "new_claims": {"type": "array", "items": {"type": "string"}},
            "status": {"enum": ["PASS", "REVISE", "NEEDS_AUTHOR"]}
          }
        },
        "logic_chain": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "statement", "depends_on", "claim_ids", "evidence_locations", "status"],
            "properties": {
              "id": {"type": "string", "pattern": "^L[0-9]{2,}$"},
              "role": {"enum": ["PROBLEM", "GAP", "QUESTION", "METHOD", "EVIDENCE", "CLAIM", "CONCLUSION"]},
              "statement": {"type": "string", "minLength": 1},
              "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^L[0-9]{2,}$"}, "uniqueItems": true},
              "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{2,}$"}, "uniqueItems": true},
              "evidence_locations": {"type": "array", "items": {"type": "string"}},
              "status": {"enum": ["SUPPORTED", "GAP", "NEEDS_AUTHOR"]}
            }
          }
        },
        "terminology": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concept_id", "canonical", "meaning", "allowed_variants", "forbidden_variants", "first_definition"],
            "properties": {
              "concept_id": {"type": "string", "pattern": "^T[0-9]{2,}$"},
              "canonical": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 1},
              "allowed_variants": {"type": "array", "items": {"type": "string"}},
              "forbidden_variants": {"type": "array", "items": {"type": "string"}},
              "first_definition": {"type": "string"}
            }
          }
        },
        "notation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["notation_id", "symbol", "meaning", "domain_or_type", "first_definition", "canonical_form", "conflicts"],
            "properties": {
              "notation_id": {"type": "string", "pattern": "^N[0-9]{2,}$"},
              "symbol": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 1},
              "domain_or_type": {"type": "string"},
              "first_definition": {"type": "string"},
              "canonical_form": {"type": "string", "minLength": 1},
              "conflicts": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "drift_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rule", "applies_to", "verification"],
            "properties": {
              "id": {"type": "string", "pattern": "^D[0-9]{2,}$"},
              "rule": {"type": "string", "minLength": 1},
              "applies_to": {"type": "array", "items": {"type": "string"}},
              "verification": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "issues": {"type": "array", "items": {"$ref": "review-output.schema.json#/$defs/issue"}},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
